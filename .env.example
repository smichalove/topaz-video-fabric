# Topaz Cluster Orchestrator - Environment Overrides (.env.example)
# Copy to .env (gitignored) to override values in config/cluster_config.yaml

TOPAZ_ARCHIVE_HOST=<USER>@<ARCHIVE_HOST>
TOPAZ_SOURCE_DIR=/path/to/source_videos
TOPAZ_DEST_DIR=/path/to/destination_4k
TOPAZ_MIN_FREE_GB=25.0
TOPAZ_MODEL=iris-3
